# Copie para .env e preencha. O .env não entra no repositório (ver .gitignore).
#
# Token do Mercado Pago. É ELE que assina as cobranças — vive só no servidor,
# nunca no HTML da página, que é público.
# Conta de teste começa com APP_USR- mas o usuário é TESTUSER...; confira com:
#   curl -H "Authorization: Bearer $MERCADOPAGO_ACCESS_TOKEN" https://api.mercadopago.com/users/me
MERCADOPAGO_ACCESS_TOKEN=

# Chave que a página manda no cabeçalho X-API-Key.
# Atenção: como a página é pública, esta chave é legível por qualquer visitante.
# Ela barra varredura automática, não um atacante decidido.
API_KEY=

# Origens que podem chamar o endpoint pelo navegador, separadas por vírgula.
# Esta é a trava que realmente vale.
ORIGENS_PERMITIDAS=https://catalogo.chinasourcetrade.com,https://chinasourcetrade.com

HOST=0.0.0.0
PORTA=8098
